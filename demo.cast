[2.536, "o", "\r\n  \u001b[1mTitle:\u001b[0m Attention Is All You Need\r\n  \u001b[1mAuthors:\u001b[0m Ashish Vaswani, Noam Shazeer, Niki Parmar\r\n  \u001b[1mPublished:\u001b[0m 2017-06-12\r\n  \u001b[1mCategories:\u001b[0m cs.CL, cs.LG\r\n  \u001b[1mPDF:\u001b[0m https://arxiv.org/pdf/1706.03762v7\r\n"]
